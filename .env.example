# Переменные окружения бэкенда. Значения — НЕ в этом файле и не в git.

YANDEX_API_KEY=       # API-ключ сервисного аккаунта Yandex Cloud (роль ai.languageModels.user)
YANDEX_FOLDER_ID=     # ID каталога Yandex Cloud
GIGACHAT_AUTH_KEY=    # Authorization Key GigaChat API (Сбер)

# Локальная модель (Ollama) — ключи не нужны; значения по умолчанию:
